          <textBox font="cbf_std" autoWidthAdjust="true">
            <fontSize x="16.666667" y="20" />
            <text>ご使用になる前に、この電子説明書をよくお読みいただき、正しくお使いください。本ソフトはNewニンテンドー3DS/Newニンテンドー3DS LLでのみ遊べます。</text>
            <topColor r="60" g="60" b="60" a="255" />
            <bottomColor r="60" g="60" b="60" a="255" />
            <positionType x="Left" y="Top" />
            <material name="TextBox_00" />
            <texEnabled>false</texEnabled>
            <texLayoutPosition>LeftTop</texLayoutPosition>
            <texOffsetLeft>0</texOffsetLeft>
            <texOffsetRight>0</texOffsetRight>
            <texOffsetTop>0</texOffsetTop>
            <texOffsetBottom>0</texOffsetBottom>
          </textBox>
        </pane>
        <pane kind="TextBox" name="TextBox_00_0">
          <basePositionType x="Left" y="Top" />
          <translate x="0" y="0" z="0" />
          <rotate x="0" y="0" z="0" />
          <scale x="1" y="1" />
          <size x="288" y="28" />
          <textBox font="cbf_std" autoWidthAdjust="true">
            <fontSize x="20" y="24" />
            <text>重要</text>
            <topColor r="255" g="255" b="255" a="255" />
            <bottomColor r="255" g="255" b="255" a="255" />
            <positionType x="Left" y="Top" />
