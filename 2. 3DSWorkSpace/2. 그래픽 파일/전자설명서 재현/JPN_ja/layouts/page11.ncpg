        <pane kind="TextBox" name="TextBox_201">
          <basePositionType x="Left" y="Top" />
          <translate x="0" y="0" z="0" />
          <rotate x="0" y="0" z="0" />
          <scale x="1" y="1" />
          <size x="300" y="144" />
          <textBox font="cbf_std" autoWidthAdjust="true">
            <fontSize x="16.666667" y="20" />
            <text>フィールドでを押すと表示されます。で項目を選んでを押してください。</text>
            <topColor r="100" g="50" b="0" a="255" />
            <bottomColor r="100" g="50" b="0" a="255" />
            <positionType x="Left" y="Top" />
            <material name="TextBox_201">
              <texMap imageName="11_01" imageNameLeft="" imageNameRight="" stereoEnabled="false" />
            </material>
            <texEnabled>true</texEnabled>
            <texLayoutPosition>RightTop</texLayoutPosition>
            <texOffsetLeft>10</texOffsetLeft>
            <texOffsetRight>6</texOffsetRight>
            <texOffsetTop>9</texOffsetTop>
            <texOffsetBottom>10</texOffsetBottom>
          </textBox>
        </pane>
